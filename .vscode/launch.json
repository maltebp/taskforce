{

    "version": "0.2.0",
    "configurations": [
        {
            "type": "gdb",
            "request": "attach",
            "name": "Automated Tests (Redux, Debug)",
            "target": "localhost:3333",
            "remote": true,
            "executable": "build\\playstation\\tests\\automated\\Debug\\td.playstation.tests.automated.elf",
            "gdbpath": "external/gdb-multiarch/bin/gdb-multiarch",
            "cwd": "${workspaceRoot}",
            "autorun": [
                "set substitute-path /project .",
                "monitor reset shellhalt",
                "load build/playstation/tests/automated/Debug/td.playstation.tests.automated.elf",
            ],
            "valuesFormatting": "prettyPrinters"
        },
    ],
}